# REC-SYSTEM environment example (no secrets)

# Use the parent NREP Appwrite project, database, and API key.
# A separate rec_system database does not contain the live conference records.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://appwrite.nrep.ug/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=parent-appwrite-project-id
APPWRITE_API_KEY=parent-appwrite-api-key
NEXT_PUBLIC_APPWRITE_DATABASE_ID=parent-database-id
NEXT_PUBLIC_API_BASE_URL=https://server.nrep.ug

AUTH_COOKIE_SECRET=change-this
NEXTAUTH_SECRET=change-this

NEXT_PUBLIC_REC_CONFERENCE_BUCKET_ID=rec_conference
NEXT_PUBLIC_REC_REGISTRATIONS_COLLECTION_ID=
NEXT_PUBLIC_REC_CONFERENCES_COLLECTION_ID=
NEXT_PUBLIC_REC_COUPONS_COLLECTION_ID=
REC_REGISTRATION_IMPORTS_COLLECTION_ID=rec_registration_imports
REC_REGISTRATION_IMPORT_ROWS_COLLECTION_ID=rec_registration_import_rows
REC_REGISTRATION_LOCKS_COLLECTION_ID=rec_registration_locks
NEXT_PUBLIC_REC_SESSIONS_COLLECTION_ID=
NEXT_PUBLIC_REC_PROGRAMMES_COLLECTION_ID=
NEXT_PUBLIC_REC_PROGRAM_TIME_BLOCKS_COLLECTION_ID=rec_program_time_blocks
NEXT_PUBLIC_REC_SPONSOR_CATEGORIES_COLLECTION_ID=rec_sponsor_categories
NEXT_PUBLIC_REC_SPONSORS_COLLECTION_ID=rec_sponsors
NEXT_PUBLIC_REC_MEDIA_ITEMS_COLLECTION_ID=rec_media_items
NEXT_PUBLIC_REC_CONFERENCE_REPORTS_COLLECTION_ID=rec_conference_reports
NEXT_PUBLIC_REC_SCAN_EVENTS_COLLECTION_ID=rec_scan_events
NEXT_PUBLIC_REC_SCANS_COLLECTION_ID=rec_scans
NEXT_PUBLIC_REC_BADGE_TOKENS_COLLECTION_ID=rec_badge_tokens
NEXT_PUBLIC_REC_SCANNER_OPERATORS_COLLECTION_ID=rec_scanner_operators
NEXT_PUBLIC_REC_SCANNER_OTPS_COLLECTION_ID=rec_scanner_otps
NEXT_PUBLIC_REC_SCANNER_SESSIONS_COLLECTION_ID=rec_scanner_sessions
NEXT_PUBLIC_REC_SCANNER_ALLOCATIONS_COLLECTION_ID=scanner_allocations
NEXT_PUBLIC_REC_EVENT_SCANS_COLLECTION_ID=event_scans
NEXT_PUBLIC_REC_SESSION_CROSS_FLAGS_COLLECTION_ID=session_cross_flags
REC_SCANNER_TOKEN_SECRET=change-this-server-only-rec-scanner-secret
# Host that serves this app's printable badge page (/badge/[token]).
# Do not use https://rec.nrep.ug here; that is the public conference website.
REC_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REC_PUBLIC_SITE_URL=http://localhost:3000
REC_WEB_APP_URL=https://rec.nrep.ug

# Parent NREP programme. Server-only. Used to copy published sessions into REC scan events.
REC_PARENT_APPWRITE_ENDPOINT=https://appwrite.nrep.ug/v1
REC_PARENT_APPWRITE_PROJECT_ID=
REC_PARENT_APPWRITE_API_KEY=
REC_PARENT_APPWRITE_DATABASE_ID=
REC_PARENT_PROGRAMMES_COLLECTION_ID=
REC_PARENT_SESSIONS_COLLECTION_ID=

REC_REGISTRATION_IMPORT_MAX_FILE_BYTES=2097152
REC_REGISTRATION_IMPORT_MAX_ROWS=500
REC_REGISTRATION_IMPORT_BATCH_SIZE=10

# Rapporteur reporting. Repository links open the HR app. The public author page is REC_PUBLIC_SITE_URL above.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USERS_COLLECTION_ID=
NEXT_PUBLIC_ENGAGE_NOTIFICATIONS_COLLECTION_ID=engage_notifications
NEXT_PUBLIC_ENGAGE_KNOWLEDGE_REPOSITORY_COLLECTION_ID=engage_knowledge_repository
NEXT_PUBLIC_ENGAGE_ATTACHMENTS_BUCKET_ID=engage_attachments
NEXT_PUBLIC_NREP_LOGO_URL=
HR_PORTAL_BASE_URL=http://localhost:3000
REC_REGISTRATION_SYNC_SECRET=
